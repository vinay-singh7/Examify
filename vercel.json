{
  "buildCommand": "cd client && npm install --legacy-peer-deps && CI=false npm run build",
  "outputDirectory": "client/build",

  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
